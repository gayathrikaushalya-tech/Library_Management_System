      </Label>
      <PasswordField fx:id="txtPassword" layoutX="615.0" layoutY="307.0" prefHeight="26.0" prefWidth="220.0" />
      <Button fx:id="btnLogin" alignment="CENTER" layoutX="522.0" layoutY="414.0" mnemonicParsing="false" onAction="#btnLoginOnAction" prefHeight="54.0" prefWidth="107.0" style="-fx-background-color: #2a18cc;" text="Login" textFill="#fcf7f7">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Button>
      <Button fx:id="btnClear" layoutX="703.0" layoutY="414.0" mnemonicParsing="false" onAction="#btnClearOnAction" prefHeight="54.0" prefWidth="107.0" style="-fx-background-color: #2a18cc;" text="Clear" textFill="#f4f0f0">
         <font>
            <Font name="System Bold" size="25.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
